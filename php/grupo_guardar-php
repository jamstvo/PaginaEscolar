<?php
    require_once "main.php";

    // Almacenando datos
    $semestre      = limpiar_cadena($_POST['semestre']);
    $especialidad    = limpiar_cadena($_POST['especialidad']);

    // Verificando campos obligatorios
    if ($semestre == "" || $especialidad == "") {
        echo '
            <div class="notification is-danger is-light">
                <strong>¡Ocurrio un error inesperado!</strong><br>
                No has llenado todos los campos que son obligatorios.
            </div>
        ';
        exit();
    }

    // Verificando integridad de los datos
    if (verificar_datos("[a-zA-Z ]{3,40}", $semestre)) {
        echo '
            <div class="notification is-danger is-light">
                <strong>¡Ocurrio un error inesperado!</strong><br>
                No coincide con el formato solicitado.
            </div>
        ';
        exit();
    }

    if (verificar_datos("[a-zA-ZáéíóúÁÉÍÓÚñÑ ]{3,40}", $especialidad)) {
        echo '
            <div class="notification is-danger is-light">
                <strong>¡Ocurrio un error inesperado!</strong><br>
                No coincide con el formato solicitado.
            </div>
        ';
        exit();
    }

    // Guardando datos (por default grupo está activo)
    $guardar_grupo = conexion();
    $guardar_grupo = $guardar_grupo->prepare("INSERT INTO grupo(semestre, especialidad) VALUES(:semestre, :especialidad)");

    $marcadores = [
        ":semestre"   => $semestre,
        ":especialidad" => $especialidad
    ];

    $guardar_grupo->execute($marcadores);

    if ($guardar_grupo->rowCount() == 1) {
        echo '
            <div class="notification is-info is-light">
                <strong>¡DOCENTE REGISTRADO!</strong><br>
                El grupo se ha registrado con éxito en el sistema.
            </div>
        ';
    } else {
        echo '
            <div class="notification is-danger is-light">
                <strong>¡Ocurrio un error inesperado!</strong><br>
                No se pudo registrar al grupo, por favor intente nuevamente.
            </div>
        ';
    }

    $guardar_grupo = null;
?>